{
  "manifest_version": 3,
  "name": "Movie Rating Check",
  "version": "0.1.0",
  "description": "Hold Alt and hover a movie or TV title on any page to see its IMDb, Rotten Tomatoes and Metacritic scores.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.omdbapi.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/title.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Movie Rating Check — click to enable/disable"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
